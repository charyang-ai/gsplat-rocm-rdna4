+template <typename K>
+static void radix_sort_pairs_bits_impl(
+    const int64_t n_isects,
+    const int64_t begin_bit,
+    const int64_t end_bit,
+    at::Tensor keys,
+    at::Tensor values,
+    at::Tensor keys_sorted,
+    at::Tensor values_sorted
+) {
+    cub::DoubleBuffer<K> d_keys(
+        keys.data_ptr<K>(), keys_sorted.data_ptr<K>()
+    );
+    cub::DoubleBuffer<int32_t> d_values(
+        values.data_ptr<int32_t>(), values_sorted.data_ptr<int32_t>()
+    );
+    CUB_WRAPPER(
+        cub::DeviceRadixSort::SortPairs,
+        d_keys,
+        d_values,
+        n_isects,
+        static_cast<int>(begin_bit),
+        static_cast<int>(end_bit),
+        GET_CURRENT_STREAM()
+    );
+    // DoubleBuffer ping-pongs, so the sorted data can end up in either allocation.
+    if (d_keys.selector == 0) {
+        keys_sorted.set_(keys);
+    }
+    if (d_values.selector == 0) {
+        values_sorted.set_(values);
+    }
+}
+
+void radix_sort_pairs_bits(
+    const int64_t n_isects,
+    const int64_t begin_bit,
+    const int64_t end_bit,
+    at::Tensor keys,
+    at::Tensor values,
+    at::Tensor keys_sorted,
+    at::Tensor values_sorted
+) {
+    if (n_isects <= 0) {
+        return;
+    }
+    if (keys.scalar_type() == at::kLong) {
+        radix_sort_pairs_bits_impl<int64_t>(
+            n_isects, begin_bit, end_bit, keys, values, keys_sorted, values_sorted
+        );
+    } else {
+        radix_sort_pairs_bits_impl<int32_t>(
+            n_isects, begin_bit, end_bit, keys, values, keys_sorted, values_sorted
+        );
+    }
+}
