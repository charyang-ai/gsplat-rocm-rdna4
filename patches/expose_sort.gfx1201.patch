+std::tuple<at::Tensor, at::Tensor> intersect_sort_pairs(
+    const at::Tensor keys,   // [n_isects] int64 or int32
+    const at::Tensor values, // [n_isects] int32
+    const int64_t begin_bit,
+    const int64_t end_bit
+) {
+    DEVICE_GUARD(keys);
+    CHECK_INPUT(keys);
+    CHECK_INPUT(values);
+    TORCH_CHECK(
+        keys.numel() == values.numel(), "keys and values must have equal length"
+    );
+    TORCH_CHECK(values.scalar_type() == at::kInt, "values must be int32");
+    TORCH_CHECK(
+        keys.scalar_type() == at::kLong || keys.scalar_type() == at::kInt,
+        "keys must be int64 or int32"
+    );
+
+    at::Tensor keys_sorted = at::empty_like(keys);
+    at::Tensor values_sorted = at::empty_like(values);
+    // NOTE: DoubleBuffer uses the *inputs* as scratch, so their contents are undefined
+    // after this call. Every caller passes a temporary, exactly as intersect_tile does.
+    radix_sort_pairs_bits(
+        keys.numel(),
+        begin_bit,
+        end_bit,
+        keys,
+        values,
+        keys_sorted,
+        values_sorted
+    );
+    return std::make_tuple(keys_sorted, values_sorted);
+}
